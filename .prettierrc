{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"semi": true,
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": ["*.json", "*.yaml", "*.yml", "*.css", "*.html", "*.md"],
			"options": { "useTabs": false }
		},
		{
			"files": ["*.svelte"],
			"options": { "htmlWhitespaceSensitivity": "strict" }
		}
	]
}
